# SALAY Frontend Environment Configuration

VITE_APP_NAME=SALAY

# FastAPI REST API Backend Endpoint URL
VITE_API_URL=http://localhost:8000

# Toggle Mock Data Mode vs Live Backend Connection
VITE_USE_MOCK=true

# Demo & Presentation Features
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_JUDGE_MODE=true
VITE_SHOW_SNOWFLAKE_BADGES=true
