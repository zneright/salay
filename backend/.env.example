# SALAY Backend Configuration

APP_ENV=development
APP_NAME=SALAY
API_VERSION=v1

HOST=0.0.0.0
PORT=8000

# Set to true to force Snowflake mode, or false to use Mock mode fallback
USE_SNOWFLAKE=false

# Snowflake Database Credentials (leave blank to run in zero-config Mock Mode)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CIVIC_TRANSPARENCY_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Snowflake Cortex AI LLM Model Selection
CORTEX_MODEL=llama3-70b

# Logging Level
LOG_LEVEL=INFO
